# ==============================================================================
# FindJob Backend - Variables de Entorno de Ejemplo
# NO almacenar credenciales reales ni secretos en este archivo.
# ==============================================================================

PROJECT_NAME="FindJob Marketplace API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
# SOLO para desarrollo/test/auditoría local. En producción debe ser False.
ALLOW_TEST_AUTH_HEADERS=True

# Configuración de CORS (lista de orígenes permitidos en formato JSON o separados por coma)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Configuración de Seguridad y Autenticación JWT
# En producción, SECRET_KEY debe obtenerse de Google Cloud Secret Manager o Azure Key Vault
SECRET_KEY="insecure-default-change-me-in-production-environment"
PREVIOUS_SECRET_KEYS=[]
ALGORITHM="HS256"
ALLOWED_ALGORITHMS=["HS256","RS256"]
JWT_ISSUER="findjob-auth"
JWT_AUDIENCE="findjob-api"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Firebase / Identity Platform (para validación de tokens federados)
FIREBASE_PROJECT_ID="findjob-dev"

